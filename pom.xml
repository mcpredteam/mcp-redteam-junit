<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.mcpredteam</groupId>
    <artifactId>mcp-redteam-parent</artifactId>
    <version>0.1.0</version>
    <packaging>pom</packaging>

    <name>MCP RedTeam JUnit</name>
    <description>JUnit-native security testing for MCP servers and MCP-connected Java agents.</description>
    <url>https://github.com/mcpredteam/mcp-redteam-junit</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>harikrishna8121999</id>
            <name>Harikrishna V Shetty</name>
            <url>https://github.com/harikrishna8121999</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/mcpredteam/mcp-redteam-junit.git</connection>
        <developerConnection>scm:git:git@github.com:mcpredteam/mcp-redteam-junit.git</developerConnection>
        <url>https://github.com/mcpredteam/mcp-redteam-junit</url>
        <tag>HEAD</tag>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/mcpredteam/mcp-redteam-junit/issues</url>
    </issueManagement>

    <modules>
        <module>mcp-redteam-core</module>
        <module>mcp-redteam-junit</module>
        <module>mcp-redteam-mcp</module>
        <module>mcp-redteam-spring-ai</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.11.4</junit.version>
        <surefire.version>3.5.2</surefire.version>
        <spring-ai.version>2.0.0</spring-ai.version>
        <jackson.version>3.1.4</jackson.version>
        <!--
          Pinned here rather than inherited: spring-ai-bom does not manage the MCP SDK, it only
          depends on it. Left unpinned, the fixture servers would drift onto whatever version
          the consumer's MCP client dragged in, and a protocol mismatch would surface as a
          fixture that mysteriously publishes no tools.
        -->
        <mcp-sdk.version>2.0.0</mcp-sdk.version>
        <!--
          Test scope only, in mcp-redteam-mcp, to stand up a Streamable HTTP MCP server locally.
          The SDK's HTTP server transports are servlet-based, so proving the Streamable HTTP
          client works needs a container; running one on loopback keeps that proof in CI instead
          of behind a network-dependent tag. Never leaves test scope, so no consumer sees it.
        -->
        <jetty.version>12.0.16</jetty.version>
        <!-- Indirected because a literal in the plugin's <configuration> cannot be overridden
             from the command line: POM configuration beats -D, so -DexcludedGroups= is silently
             ignored and the tests it was meant to enable simply do not run. -->
        <test.excludedGroups>live</test.excludedGroups>

        <!-- Release tooling. Only the publishing plugin is active in an ordinary build; the rest
             live in the `release` profile, because signing needs a GPG key no contributor has. -->
        <central-publishing-plugin.version>0.11.0</central-publishing-plugin.version>
        <source-plugin.version>3.4.0</source-plugin.version>
        <javadoc-plugin.version>3.12.0</javadoc-plugin.version>
        <gpg-plugin.version>3.2.8</gpg-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.modelcontextprotocol.sdk</groupId>
                <artifactId>mcp</artifactId>
                <version>${mcp-sdk.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${surefire.version}</version>
                    <configuration>
                        <!--
                          Tests needing a real model provider are tagged `live` and excluded
                          here, so the exclusion is enforced by the build rather than by every
                          author remembering an @Disabled. Run them with -Dtest.excludedGroups=
                          and expect an API bill.
                        -->
                        <excludedGroups>${test.excludedGroups}</excludedGroups>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!--
              Replaces maven-deploy-plugin: `mvn deploy` uploads a bundle to the Central Portal
              rather than to a staging repository. Harmless in an ordinary build, which never
              reaches the deploy phase.
            -->
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <version>${central-publishing-plugin.version}</version>
                <extensions>true</extensions>
                <configuration>
                    <publishingServerId>central</publishingServerId>
                    <!--
                      A published version can never be deleted, overwritten or recalled. So the
                      upload stops at "validated" and waits for a human to press publish in the
                      Portal. Flip this to true only once several releases have gone out without
                      surprises — the cost of an unreviewed mistake here is permanent.
                    -->
                    <autoPublish>false</autoPublish>
                    <waitUntil>validated</waitUntil>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          Everything Central requires of a release but an ordinary build should not pay for:
          a sources jar, a javadoc jar, and a detached GPG signature over each. Activated by
          the release workflow (`mvn -Prelease deploy`), not by `mvn verify`.
        -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>${source-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>${javadoc-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <!--
                              `all` minus `missing`: broken @link targets, malformed HTML and
                              heading-level jumps still fail the build — two of those were real
                              and were fixed rather than silenced. What is suppressed is only the
                              absence of a comment, which would otherwise block a release on
                              ~70 accessors that document themselves. Tightening this to plain
                              `all` is a worthwhile later pass, not a release gate.
                            -->
                            <doclint>all,-missing</doclint>
                            <quiet>true</quiet>
                        </configuration>
                    </plugin>

                    <!--
                      Deliberately unconfigured. The plugin picks gpg's pinentry mode itself,
                      from whether it has a passphrase: given one it asks for loopback mode and
                      feeds the passphrase on stdin; given none it asks for "error" mode, so the
                      build fails outright instead of blocking on a prompt no CI runner can
                      answer.

                      An earlier version set loopback mode here explicitly, via gpgArguments. It
                      did nothing. The plugin appends its own copy of that flag later on the
                      command line, and gpg honours the last occurrence, so the hand-written one
                      was silently overridden in exactly the case it was meant to cover. Dead
                      configuration that looks load-bearing is worse than none, so it is gone.

                      The passphrase reaches the plugin through MAVEN_GPG_PASSPHRASE: set by the
                      release workflow from the `central` environment, and set by hand for a
                      local signing rehearsal.
                    -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>${gpg-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
