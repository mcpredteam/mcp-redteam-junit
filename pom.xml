<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.harikrishna8121999</groupId>
    <artifactId>mcp-redteam-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>MCP RedTeam JUnit</name>
    <description>JUnit-native security testing for MCP servers and MCP-connected Java agents.</description>
    <url>https://github.com/harikrishna8121999/mcp-redteam-junit</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>harikrishna8121999</id>
            <name>Harikrishna V Shetty</name>
            <url>https://github.com/harikrishna8121999</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/harikrishna8121999/mcp-redteam-junit.git</connection>
        <developerConnection>scm:git:git@github.com:harikrishna8121999/mcp-redteam-junit.git</developerConnection>
        <url>https://github.com/harikrishna8121999/mcp-redteam-junit</url>
        <tag>HEAD</tag>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/harikrishna8121999/mcp-redteam-junit/issues</url>
    </issueManagement>

    <modules>
        <module>mcp-redteam-core</module>
        <module>mcp-redteam-junit</module>
        <module>mcp-redteam-mcp</module>
        <module>mcp-redteam-spring-ai</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.11.4</junit.version>
        <surefire.version>3.5.2</surefire.version>
        <spring-ai.version>2.0.0</spring-ai.version>
        <jackson.version>3.2.1</jackson.version>
        <!--
          Pinned here rather than inherited: spring-ai-bom does not manage the MCP SDK, it only
          depends on it. Left unpinned, the fixture servers would drift onto whatever version
          the consumer's MCP client dragged in, and a protocol mismatch would surface as a
          fixture that mysteriously publishes no tools.
        -->
        <mcp-sdk.version>2.0.0</mcp-sdk.version>
        <!--
          Test scope only, in mcp-redteam-mcp, to stand up a Streamable HTTP MCP server locally.
          The SDK's HTTP server transports are servlet-based, so proving the Streamable HTTP
          client works needs a container; running one on loopback keeps that proof in CI instead
          of behind a network-dependent tag. Never leaves test scope, so no consumer sees it.
        -->
        <jetty.version>12.0.16</jetty.version>
        <!-- Indirected because a literal in the plugin's <configuration> cannot be overridden
             from the command line: POM configuration beats -D, so -DexcludedGroups= is silently
             ignored and the tests it was meant to enable simply do not run. -->
        <test.excludedGroups>live</test.excludedGroups>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.modelcontextprotocol.sdk</groupId>
                <artifactId>mcp</artifactId>
                <version>${mcp-sdk.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${surefire.version}</version>
                    <configuration>
                        <!--
                          Tests needing a real model provider are tagged `live` and excluded
                          here, so the exclusion is enforced by the build rather than by every
                          author remembering an @Disabled. Run them with -Dtest.excludedGroups=
                          and expect an API bill.
                        -->
                        <excludedGroups>${test.excludedGroups}</excludedGroups>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
